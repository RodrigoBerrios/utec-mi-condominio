# Base de datos PostgreSQL (para ms-inmuebles, ms-cuotas, ms-gastos, ms-junta)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=condominio_db
DB_USER=postgres
DB_PASSWORD=password

# AWS EventBridge
EVENTBRIDGE_BUS=condominio-events

# S3 Bucket para comprobantes (ms-gastos)
S3_BUCKET=condominio-comprobantes

# Stage de despliegue
STAGE=dev

# SES para notificaciones por email
SES_FROM_EMAIL=noreply@micondominio.com
SES_REGION=us-east-1 