{
  "name": "mi-condominio-microservicios",
  "version": "1.0.0",
  "description": "Sistema de gestión de condominios con arquitectura de microservicios para AWS Lambda",
  "private": true,
  "workspaces": [
    "ms-inmuebles",
    "ms-cuotas",
    "ms-gastos",
    "ms-junta",
    "ms-notificaciones",
    "ms-inmobiliarias"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "test": "npm run test --workspaces",
    "deploy": "npm run deploy --workspaces",
    "clean": "npm run clean --workspaces"
  },
  "devDependencies": {
    "@types/jest": "^29.0.0",
    "@types/node": "^20.0.0",
    "esbuild": "^0.25.5",
    "jest": "^29.0.0",
    "serverless": "^3.0.0",
    "serverless-dotenv-plugin": "^6.0.0",
    "serverless-esbuild": "^1.55.0",
    "serverless-offline": "^13.0.0",
    "ts-jest": "^29.0.0",
    "typescript": "^5.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
